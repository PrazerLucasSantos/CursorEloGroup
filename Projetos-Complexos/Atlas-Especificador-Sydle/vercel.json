{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/data", "destination": "/api/data.json" },
    { "source": "/portal-cliente", "destination": "/portal-cliente.html" },
    { "source": "/portal-parceiro", "destination": "/portal-parceiro.html" },
    { "source": "/documentador", "destination": "/documentador.html" }
  ]
}
